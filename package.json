{
  "name": "chromoforge",
  "version": "0.1.0",
  "private": true,
  "description": "Design life for worlds we know exist — a synthetic-biology foundry for real exoplanets.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "agents:test": "cd python/agents && python -m pytest tests -q",
    "rust:check": "cargo check --tests --manifest-path crates/ecology/Cargo.toml",
    "parity": "sh bin/parity.sh",
    "sim:batch": "cargo run --release --manifest-path crates/ecology/Cargo.toml",
    "loc": "node scripts/loc-count.mjs",
    "loc:gate": "node scripts/loc-count.mjs --min-lines 100000",
    "gen:assets": "node scripts/gen-assets.mjs",
    "agents:dev": "cd python/agents && python -m uvicorn main:app --reload --port 8787"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "16.4.2",
    "next-themes": "^0.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@repo/config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "turbo": "^2.5.4",
    "typescript": "^7",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.3.14"
}
