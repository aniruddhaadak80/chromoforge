# chromoforge runs with ZERO required environment variables.
# This file documents the optional knobs only — never commit real values.

# Public site URL, used to resolve absolute Open Graph image URLs.
# Set this to your deployment URL in Vercel/hosting settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: root password for the Python agent service in docker-compose.
# Leave unset in local development.
AGENTS_SERVICE_TOKEN=

# Optional: NASA Exoplanet Archive fetch script has no auth; rate limits apply.
# docs/guides/data-provenance.md explains the offline seed instead.
